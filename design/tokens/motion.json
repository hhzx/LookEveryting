{
  "$schema": "./schema.json",
  "meta": {
    "name": "LookEveryting Motion",
    "version": "1.0.0"
  },
  "duration": {
    "instant": 0,
    "fast": 120,
    "normal": 200,
    "slow": 300,
    "slower": 400
  },
  "easing": {
    "default": "cubic-bezier(0.4, 0, 0.2, 1)",
    "in": "cubic-bezier(0.4, 0, 1, 1)",
    "out": "cubic-bezier(0, 0, 0.2, 1)",
    "in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "presets": {
    "toolbar-fade": {
      "duration": "normal",
      "easing": "out",
      "property": "opacity"
    },
    "panel-slide": {
      "duration": "slow",
      "easing": "out",
      "property": "transform"
    },
    "image-crossfade": {
      "duration": "fast",
      "easing": "in-out",
      "property": "opacity"
    },
    "toast-enter": {
      "duration": "normal",
      "easing": "spring",
      "property": "transform, opacity"
    }
  },
  "behavior": {
    "toolbar-auto-hide-delay-ms": 3000,
    "reduced-motion": "respect-system-preference"
  }
}
